# Copy to voice/.env yourself. Never paste credentials into chat or commit them.
BRAIN_URL=http://localhost:8000
# D-050: Photon -> LiveKit SIP -> Pipecat. No Twilio/tunnel required for this route.
VOICE_TRANSPORT=livekit
# Enable only after scripts/check_brain_approval_boundary.py passes against the brain.
VOICE_CONVERSATION_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
PHOTON_PHONE_NUMBER=
# Generate these under the Photon Default profile's Outbound calls (SHA-256).
# These are separate from the project API key. Inbound may remain disabled.
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=
VOICE_HOST=127.0.0.1
VOICE_PORT=8100
# Exact public HTTPS tunnel origin (Cloudflare or ngrok); no path or trailing slash.
VOICE_PUBLIC_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio-owned number used as the caller ID when forwarding to the teammate.
TWILIO_PHONE_NUMBER=
MAYA_PHONE_NUMBER=
# Comma-separated E.164 teammate numbers, including Maya and the simulated caller.
OUTBOUND_ALLOWLIST=
# Generate a random value locally, e.g. python -c "import secrets; print(secrets.token_hex(32))"
HASH_SALT=

# Simulated carrier metadata, disclosed in the demo. Never derived from call audio.
SCAM_CALLER_NAME=T-Mobile Support
SCAM_ATTESTATION=C
SCAM_SEEN_BEFORE=false
SCAM_LABEL=false

# Bridge probe is explicit and off by default. Forwarding never streams audio.
VOICE_BRIDGE_PROBE_ENABLED=false
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
NVIDIA_API_KEY=
# D-035: approved hosted successor to the retired Nano model. Thinking is disabled in requests.
VOICE_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_VOICE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
VOICE_GUARD_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
# For TTS_PROVIDER=magpie: choose from GetRivaSynthesisConfig, not an invented voice.
MAGPIE_VOICE_ID=

# D-046: trial-number probe first; Photon SIP routing is configured separately.
# These credentials are not consumed by this Twilio-facing Python service.
PHOTON_PROJECT_ID=
PHOTON_SECRET_KEY=
# Optional approved nano-role Brev endpoint; hosted Lightning is the fallback.
NEMOTRON_NANO_BASE_URL=
NEMOTRON_NANO_SELF_MODEL=
NEMOTRON_NANO_SELF_KEY=
