{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan/contracts/v0.3",
  "title": "Titan contracts v0.3",
  "$defs": {
    "Source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "record": {
          "type": "string",
          "description": "Internal record ref, e.g. events/evt_123"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Where a fact came from. Every Signal and claim carries one."
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "User": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "pattern": "^usr_"
        },
        "name": {
          "type": "string"
        },
        "persona": {
          "type": "string"
        },
        "face_enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "user_id",
        "name",
        "face_enabled"
      ],
      "additionalProperties": false
    },
    "CallData": {
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "in",
            "out"
          ]
        },
        "other_number_hash": {
          "type": "string"
        },
        "caller_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attestation": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "none"
          ]
        },
        "seen_before": {
          "type": "boolean"
        },
        "scam_label": {
          "type": "boolean"
        }
      },
      "required": [
        "direction",
        "other_number_hash",
        "attestation",
        "seen_before",
        "scam_label"
      ],
      "additionalProperties": false,
      "description": "call.started payload. Metadata only, never content. Simulated carrier signal in the demo."
    },
    "CallEndedData": {
      "type": "object",
      "properties": {
        "duration_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "duration_s"
      ],
      "additionalProperties": false
    },
    "LoginData": {
      "type": "object",
      "properties": {
        "device_hash": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "new_device": {
          "type": "boolean"
        },
        "succeeded": {
          "type": "boolean"
        }
      },
      "required": [
        "device_hash",
        "region",
        "new_device",
        "succeeded"
      ],
      "additionalProperties": false
    },
    "OtpData": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "login",
            "account_change",
            "transfer_pin"
          ]
        }
      },
      "required": [
        "purpose"
      ],
      "additionalProperties": false
    },
    "PinAttemptData": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "channel": {
          "type": "string",
          "enum": [
            "portal",
            "app",
            "care"
          ]
        }
      },
      "required": [
        "ok",
        "channel"
      ],
      "additionalProperties": false
    },
    "ProtectionChangeData": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "sim_protection",
            "port_out_protection",
            "scam_block"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "via": {
          "type": "string",
          "enum": [
            "portal",
            "app",
            "care",
            "titan"
          ]
        }
      },
      "required": [
        "name",
        "enabled",
        "via"
      ],
      "additionalProperties": false
    },
    "LineRegionData": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string"
        }
      },
      "required": [
        "region"
      ],
      "additionalProperties": false,
      "description": "line.region payload: where the phone on this line is right now (serving region). Simulated carrier signal, read only at a trigger."
    },
    "SimSwapData": {
      "type": "object",
      "properties": {
        "new_device_hash": {
          "type": "string"
        },
        "channel": {
          "type": "string",
          "enum": [
            "portal",
            "app",
            "care",
            "store"
          ]
        }
      },
      "required": [
        "new_device_hash",
        "channel"
      ],
      "additionalProperties": false
    },
    "PortalSignals": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "page_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ms_per_step": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "hesitation_ms": {
          "type": "number",
          "minimum": 0
        },
        "paste_into_pin": {
          "type": "boolean"
        },
        "tab_switches": {
          "type": "integer",
          "minimum": 0
        },
        "pointer_speed": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "typing_rhythm_distance": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "page_path",
        "hesitation_ms",
        "paste_into_pin",
        "tab_switches"
      ],
      "additionalProperties": false,
      "description": "Derived numbers only. Never keystrokes or typed text."
    },
    "ForwardedMessage": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "imessage",
            "sms"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        },
        "image_url": {
          "type": "string"
        },
        "from_hash": {
          "type": "string"
        }
      },
      "required": [
        "channel"
      ],
      "additionalProperties": false
    },
    "CustomerReply": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "imessage",
            "sms",
            "voice",
            "web"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        },
        "case_id": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "text"
      ],
      "additionalProperties": false
    },
    "FaceResult": {
      "type": "object",
      "properties": {
        "match": {
          "type": "boolean"
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "liveness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "antispoof": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "match",
        "similarity",
        "liveness",
        "antispoof"
      ],
      "additionalProperties": false,
      "description": "Computed on the device. No images or descriptors leave it."
    },
    "Event": {
      "type": "object",
      "description": "Anything that happened on the account. POST /events. Idempotent on event_id.",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^evt_"
        },
        "user_id": {
          "type": "string",
          "pattern": "^usr_"
        },
        "type": {
          "type": "string",
          "enum": [
            "call.started",
            "call.ended",
            "login",
            "otp.sent",
            "otp.entered",
            "pin.attempt",
            "protection.changed",
            "transfer_pin.requested",
            "sim_swap.requested",
            "portal.signals",
            "message.forwarded",
            "customer.reply",
            "face.result",
            "line.region"
          ]
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "portal",
            "voice",
            "messaging",
            "console",
            "watcher",
            "generator",
            "brain"
          ]
        },
        "call_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^call_"
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "user_id",
        "type",
        "ts",
        "source",
        "data"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "call.started"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/CallData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "call.ended"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/CallEndedData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "login"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/LoginData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "otp.sent"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/OtpData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "otp.entered"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/OtpData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pin.attempt"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/PinAttemptData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "protection.changed"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/ProtectionChangeData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sim_swap.requested"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/SimSwapData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "portal.signals"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/PortalSignals"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "message.forwarded"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/ForwardedMessage"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "customer.reply"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/CustomerReply"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "face.result"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/FaceResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "line.region"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/LineRegionData"
              }
            }
          }
        }
      ]
    },
    "CallSummary": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "pattern": "^call_"
        },
        "caller_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attestation": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "none"
          ]
        },
        "seen_before": {
          "type": "boolean"
        },
        "scam_label": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "call_id",
        "caller_name",
        "attestation",
        "seen_before",
        "scam_label",
        "started_at",
        "ended_at",
        "duration_s"
      ],
      "additionalProperties": false
    },
    "Timeline": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CallSummary"
          }
        },
        "active_call": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallSummary"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "user_id",
        "events",
        "calls",
        "active_call"
      ],
      "additionalProperties": false
    },
    "ProtectionState": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "protections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "sim_protection",
                  "port_out_protection",
                  "scam_block"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "name",
              "enabled",
              "updated_at"
            ],
            "additionalProperties": false
          }
        },
        "shield_mode": {
          "type": "boolean",
          "description": "True while an unverified call is active: turning protections off needs the pause screen (+ face check if enabled)."
        },
        "transfer_pin": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "none",
                "held",
                "active",
                "revoked"
              ]
            },
            "hold_until": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "hold_until"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "user_id",
        "protections",
        "shield_mode",
        "transfer_pin"
      ],
      "additionalProperties": false
    },
    "ProtectionChangeRequest": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "via": {
          "type": "string",
          "enum": [
            "portal",
            "titan",
            "care"
          ]
        },
        "check_id": {
          "type": "string",
          "description": "From POST /check; required when turning a protection off"
        }
      },
      "required": [
        "enabled",
        "via"
      ],
      "additionalProperties": false
    },
    "CheckRequest": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "pattern": "^usr_"
        },
        "action": {
          "type": "string",
          "enum": [
            "protection_off",
            "transfer_pin",
            "sim_swap",
            "change_email",
            "change_password",
            "add_line",
            "login"
          ]
        },
        "protection": {
          "type": "string",
          "enum": [
            "sim_protection",
            "port_out_protection",
            "scam_block"
          ]
        },
        "portal_signals": {
          "$ref": "#/$defs/PortalSignals"
        },
        "face": {
          "$ref": "#/$defs/FaceResult"
        },
        "customer_choice": {
          "type": "string",
          "enum": [
            "on_call_help",
            "doing_it_myself"
          ]
        }
      },
      "required": [
        "user_id",
        "action"
      ],
      "additionalProperties": false,
      "description": "Fast gate before a sensitive action. No LLM. Must answer in < 300 ms."
    },
    "CheckResponse": {
      "type": "object",
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^chk_"
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "pause",
            "hold",
            "block"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "during_call": {
          "type": "boolean"
        },
        "call": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskScore"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hold_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "pause_screen": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "help_label": {
                  "type": "string"
                },
                "continue_label": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "body",
                "help_label",
                "continue_label"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "check_id",
        "decision",
        "reasons",
        "during_call"
      ],
      "additionalProperties": false
    },
    "Signal": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "enum": [
            "account",
            "device",
            "protection",
            "call",
            "location",
            "portal",
            "face",
            "message"
          ]
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "baseline": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "group",
        "name",
        "value",
        "source"
      ],
      "additionalProperties": false
    },
    "RiskScore": {
      "type": "object",
      "properties": {
        "threat": {
          "type": "string",
          "enum": [
            "takeover",
            "coached",
            "scam_text",
            "bot",
            "legit"
          ]
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "calibrated": {
          "type": "boolean"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "anomaly": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "top_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feature": {
                "type": "string"
              },
              "contribution": {
                "type": "number"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "feature",
              "contribution",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "model": {
          "type": "string",
          "enum": [
            "rules",
            "ml",
            "ml+rules"
          ]
        }
      },
      "required": [
        "threat",
        "probability",
        "calibrated",
        "confidence",
        "top_reasons",
        "model"
      ],
      "additionalProperties": false,
      "description": "Output of ml.score() (Lane 2b) and of the Risk agent."
    },
    "Verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "downgraded"
          ]
        },
        "claims_checked": {
          "type": "integer",
          "minimum": 0
        },
        "claims_dropped": {
          "type": "integer",
          "minimum": 0
