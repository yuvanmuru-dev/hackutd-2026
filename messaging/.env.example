# Photon 2.0 Beta only. Key needs project:read and project:write.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_HANDLE=
BRAIN_URL=http://localhost:8000
PORT=8200
# Comma-separated E.164 teammate-owned numbers. No outbound without this.
OUTBOUND_ALLOWLIST=
USER_PHONE_usr_maya=
# A dedicated consumer directory per Photon project; contains IDs/cursor only.
MESSAGING_STATE_DIR=.state
NVIDIA_API_KEY=
MESSAGING_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
MESSAGING_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
