    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
