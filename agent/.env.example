# Get a key at https://build.nvidia.com (Settings > API Keys). Starts with nvapi-
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1   # brain LLM endpoint (hosted)
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # Risk/Verifier/Response (3 Super is listed but 404s on free keys)
AGENT_MAX_STEPS=10
NEMOTRON_NANO_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # Context, reply reading, fallback
NEMOTRON_THINKING=off      # off = faster answers (chat_template_kwargs.enable_thinking=false)
SAFETY_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
MOCK=1                     # 1 = replay fixtures; 0 = real Nemotron workflow
REPLY_TIMEOUT_S=60         # wait for her reply before Titan calls
RECOVERY_TIMEOUT_S=240
MESSAGING_URL=http://localhost:8200
VOICE_URL=http://localhost:8100

# Voice (lane B)
# Voice endpoints: hosted by default; point at the Brev box (http://<brev-host>:<port>) to self-host
VOICE_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
MESSAGING_LLM_BASE_URL=https://integrate.api.nvidia.com/v1   # point at the Brev box to self-host Nano
NEMOTRON_VOICE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # needs enable_thinking=false
ASR_ENDPOINT=grpc.nvcf.nvidia.com:443
TTS_ENDPOINT=grpc.nvcf.nvidia.com:443
TTS_PROVIDER=elevenlabs    # elevenlabs (default, Starter plan) | magpie (NVIDIA fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Email (lane C)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
# Database
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Scam-link checks (Lane 2a check_message). Free key from https://auth.abuse.ch/ ; empty = URLhaus check returns "unverifiable"
URLHAUS_AUTH_KEY=
