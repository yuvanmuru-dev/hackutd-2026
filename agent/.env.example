ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Email (lane C)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
# Database
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
